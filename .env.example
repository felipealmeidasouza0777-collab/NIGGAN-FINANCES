# GEMINI_API_KEY: Required for Gemini AI API calls.
# Used ONLY by server.ts (the Express backend) — never exposed to the browser.
# In AI Studio this is auto-injected. Running locally/outside AI Studio, get a
# free key at https://aistudio.google.com/apikey and put it here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_SERVER_PORT: Port for the local Express AI server (server.ts). Optional, defaults to 8787.
AI_SERVER_PORT=8787

# --- Supabase (opcional) ---
# Sem essas duas variáveis o app funciona 100% offline (localStorage), como antes.
# Preenchendo as duas, o login e a sincronização na nuvem são ativados automaticamente.
# Encontre esses valores em: Supabase → seu projeto → Project Settings → API.
# IMPORTANTE: estas são variáveis do FRONTEND (prefixo VITE_), então use a
# "anon public key", nunca a "service_role key".
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLICA"
